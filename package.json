{
  "name": "ahmed-mahdy-portfolio-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "audio:generate": "npm run build && node --env-file=.env.local scripts/narration-generate.mjs --generate",
    "check": "node scripts/validate.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate *.html",
    "lint:css": "stylelint *.css styles/*.css",
    "lint:js": "biome check build.mjs preference-bootstrap.js scripts",
    "dev": "npm run build && node scripts/serve.mjs --root dist --port 4173",
    "preview": "npm run build && node scripts/serve.mjs --root dist --port 4174",
    "test": "npm run lint && npm run check && npm run build && npm run test:browser && npm run test:visual && npm run test:performance",
    "test:browser": "node scripts/responsive-smoke.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:performance": "node scripts/performance-budget.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "ship": "node scripts/ship.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.2.5",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "html-validate": "^10.10.0",
    "linkedom": "^0.18.12",
    "pixelmatch": "^7.1.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
